# 网络监控系统环境变量配置示例

# 基本配置
CHECK_INTERVAL=30
ALERT_COOLDOWN=300
TIMEOUT=5
PACKET_COUNT=4
STATISTICS_WINDOW=3600
ALERT_THRESHOLD=0.5

# 数据库配置
DATABASE_ENABLED=true
RETENTION_DAYS=30

# 邮件报警配置
EMAIL_ENABLED=false
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-password
TO_EMAILS=admin@yourcompany.com,manager@yourcompany.com

# Webhook报警配置
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your-dingtalk-token

# 短信报警配置
SMS_ENABLED=false
SMS_API_URL=https://sms.example.com/send

# Docker相关
PYTHONUNBUFFERED=1
PORT=8080